# ===== MAJBURIY =====
AI_API_KEY=                      # AI provayder kaliti (OpenAI-mos API)
AI_BASE_URL=https://api.deepseek.com   # provayder manzili (ixtiyoriy, almashtirish mumkin)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=             # service_role — FAQAT serverda!
SLIDE_STUDIO_HMAC_SECRET=        # uzun tasodifiy qator: openssl rand -hex 32
PUBLIC_BASE_URL=https://sizning-domeningiz.com

# ===== TELEGRAM BOT (webhook) =====
# BotFather'dan olingan token. Bo'sh = bot o'chiq (sayt odatdagidek ishlaydi).
TELEGRAM_BOT_TOKEN=
# ixtiyoriy: webhook maxfiy kaliti (bo'sh = tokendan avtomatik hosil bo'ladi)
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_MODE=auto               # auto | webhook | polling (auto: webhook o'rnatilmasa polling ga o'tadi)
# LOG_LEVEL=warning                # info qilsangiz so'rov loglari ham chiqadi

# ===== XAVFSIZLIK =====
ALLOWED_ORIGINS=                 # bo'sh = faqat o'z domeni. Kerak bo'lsa: https://a.com,https://b.com
# SLIDE_STUDIO_DEV_MODE=         # productionda BO'SH qoldiring!

# ===== IXTIYORIY (sifat) =====
KLIPY_API_KEY=
GIPHY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_CLIENT_ID=

# ===== LIMITLAR / NARX =====
FREE_DAILY_PAGES=10              # bepul: kuniga 10 Tez-varaq (= 5 Chuqur-varaq). Pullik balans 10 dan kam bo'lsagina beriladi
PAGES_PER_PACK=100              # pullik paket: 100 Tez-varaq (= 50 Chuqur-varaq)
PACK_PRICE_USD=1.00              # Lemon Squeezy variant narxi ham $1.00 bo'lsin
IMG_PROXY_CACHE_MB=32            # server RAM keshi (diskka yozilmaydi)

# ===== TO'LOV (Lemon Squeezy) =====
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=            # varaq PAKETI mahsuloti (bir martalik)
LEMON_SQUEEZY_PRO_VARIANT_ID=        # v47: PRO mahsuloti (bir martalik, PRO_DAYS kunga). Bo'sh = "Pro olish" ishlamaydi (admin qo'lda bera oladi)
LEMON_SQUEEZY_WEBHOOK_SECRET=
PRO_PRICE_USD=5.00                   # Lemon Squeezy Pro variant narxi bilan bir xil bo'lsin
PRO_DAYS=30                          # bitta Pro to'lovi necha kun beradi
PRO_DAILY_PAGES=60                   # Pro: kuniga bepul Tez-varaq (admin paneldan ham o'zgaradi)

# ===== ADMIN (v47) =====
# Admin = Telegram ID VA unga ulangan Google email — IKKALASI ham mos kelishi shart.
# Telegram ID ni bilish: botga /id deb yozing. Bir nechta bo'lsa vergul bilan.
ADMIN_TG_IDS=
ADMIN_EMAILS=

