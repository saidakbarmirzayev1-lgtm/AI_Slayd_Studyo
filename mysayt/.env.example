# ===== MAJBURIY =====
AI_API_KEY=                      # AI provayder kaliti (OpenAI-mos API)
AI_BASE_URL=https://api.deepseek.com   # provayder manzili (ixtiyoriy, almashtirish mumkin)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=             # service_role — FAQAT serverda!
SLIDE_STUDIO_HMAC_SECRET=        # uzun tasodifiy qator: openssl rand -hex 32
PUBLIC_BASE_URL=https://sizning-domeningiz.com

# ===== TELEGRAM BOT (webhook) =====
# BotFather'dan olingan token. Bo'sh = bot o'chiq (sayt odatdagidek ishlaydi).
TELEGRAM_BOT_TOKEN=
# ixtiyoriy: webhook maxfiy kaliti (bo'sh = tokendan avtomatik hosil bo'ladi)
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_MODE=auto               # auto | webhook | polling (auto: webhook o'rnatilmasa polling ga o'tadi)
# LOG_LEVEL=warning                # info qilsangiz so'rov loglari ham chiqadi

# ===== XAVFSIZLIK =====
ALLOWED_ORIGINS=                 # bo'sh = faqat o'z domeni. Kerak bo'lsa: https://a.com,https://b.com
# SLIDE_STUDIO_DEV_MODE=         # productionda BO'SH qoldiring!

# ===== IXTIYORIY (sifat) =====
KLIPY_API_KEY=
GIPHY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_CLIENT_ID=

# ===== LIMITLAR / NARX =====
FREE_DAILY_PAGES=15              # bepul: kuniga 15 Tez-varaq (= 5 Chuqur-varaq)
PAGES_PER_PACK=150              # pullik paket: 150 Tez-varaq (= 50 Chuqur-varaq)
PACK_PRICE_USD=1.00              # Lemon Squeezy variant narxi ham $1.00 bo'lsin
IMG_PROXY_CACHE_MB=32            # server RAM keshi (diskka yozilmaydi)

# ===== TO'LOV (Lemon Squeezy) =====
